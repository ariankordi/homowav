{
	"compilerOptions": {
		"target": "es2020",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["es2020", "dom", "dom.iterable"],
		"jsx": "react-jsx",
		"jsxImportSource": "preact",
		"strict": true,
		"noImplicitAny": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"types": ["vite/client"]
	},
	"include": ["src", "vite.config.ts"]
}
